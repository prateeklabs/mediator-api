# Mediator Server
PORT=3000

# Local LLM API (LM Studio on pve1 via LM Link to RTX 3090)
LOCAL_API_URL=http://localhost:1234/v1
LOCAL_MODEL=qwen/qwen3.8-27b
LOCAL_API_KEY=lm-studio

# OpenRouter (for complex tasks)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=x-ai/grok-4.5
OPENROUTER_API_KEY=sk-or-...

# Classifier mode: keyword | hybrid | llm
# keyword = keyword matching only (fast, no LLM call)
# hybrid  = keyword fast path + LLM fallback
# llm     = always LLM classify
CLASSIFIER_MODE=keyword

# Request timeout to backends (ms)
FETCH_TIMEOUT_MS=120000

# Admin dashboard (https://api.buildwithprateek.com/config)
# HTTP Basic auth. The mediator reads these from the SAME file the Hermes
# dashboard uses (/root/.hermes/.env -> mounted read-only as /hermes-auth.env):
#   HERMES_DASHBOARD_BASIC_AUTH_USERNAME / HERMES_DASHBOARD_BASIC_AUTH_PASSWORD
# => rotate the password ONCE in /root/.hermes/.env and both dashboards update.
# (You may still set DASH_AUTH_USERNAME / DASH_AUTH_PASSWORD here as an override,
#  e.g. for a standalone dev container without the hermes file.)
